# =====================================================================
# InteliScale Activation System - Environment Configuration Template
# =====================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Vercel:
#   Configure in: Project Settings -> Environment Variables
# =====================================================================

# --- Cryptographic Keys ---
# Legacy HMAC Secret Key (Version 1 backward compatibility with existing scale.py)
SECRET_KEY=your_legacy_hmac_secret_key_here

# Next-Gen Ed25519 Private Key (Version 2 - PEM format, SERVER-SIDE ONLY)
# Never expose this to client or GitHub
ED25519_PRIVATE_KEY="your_ed25519_private_key_pem_here"

# Next-Gen Ed25519 Public Key (Version 2 - PEM format, embedded into scale.py client)
ED25519_PUBLIC_KEY="your_ed25519_public_key_pem_here"

# Default License Version ('v1' for legacy 12-char code, 'v2' for Ed25519 signature)
DEFAULT_LICENSE_VERSION=v1

# --- Firebase Configuration ---
# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Recommended: Google Service Account Credentials (Full JSON string or base64)
# Download from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Legacy Fallback: Firebase Database Secret or Auth Token
FIREBASE_DB_SECRET=your_firebase_database_secret_here

# --- Admin Authentication ---
# Dedicated Admin Secret for managing distributors (e.g. adding devices via /api/add-device)
ADMIN_SECRET=your_strong_random_admin_password_here

# --- Network & Rate Limiting ---
# Allowed CORS Origins (comma-separated list, or '*' for open access)
# In production, specify your Vercel domain: e.g. https://your-project.vercel.app
ALLOWED_ORIGINS=*

# Rate limit per IP per minute (default: 20)
RATE_LIMIT_PER_MINUTE=20

# Audit logging of code generations to Firebase RTDB (/generation_logs)
ENABLE_AUDIT_LOGS=true
